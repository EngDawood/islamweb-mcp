{
  "name": "islamweb-mcp",
  "version": "0.1.0",
  "description": "MCP server for fetching and extracting content from islamweb.net, with a bundled crawler for Lisan al-Arab (Ibn Manzur)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "islamweb-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "crawl:lisan": "node dist/cli.js crawl-lisan-al-arab"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cheerio": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
