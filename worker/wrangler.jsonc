{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "islamweb-dictionaries-mcp",
  "main": "src/index.ts",
  // Bump this to today's date if you redeploy later.
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "IslamwebMcp" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IslamwebMcp"] }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "islamweb-dictionaries",
      "database_id": "c2192e0a-6472-4077-83d0-8d029f3a5c44"
    }
  ],

  "observability": { "enabled": true }
}
